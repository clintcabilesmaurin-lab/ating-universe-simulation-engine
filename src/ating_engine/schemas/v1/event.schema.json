{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ating.universe/schemas/v1/event.schema.json",
  "title": "SimulationEventContract",
  "description": "Foundational contract schema for simulation events in the Ating Universe.",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "world_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "occurrence_time": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "PROCESSED", "CANCELLED", "FAILED"],
      "default": "PENDING"
    },
    "payload": { "type": "object" },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["source_id", "source_type", "created_at"],
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "required": ["event_id", "world_id", "event_type", "occurrence_time", "provenance"],
  "additionalProperties": false
}
