# Ating Universe Simulation Engine - Environment Configuration Template
# Copy this file to .env and provide your local configuration values.
# NEVER commit credentials or secrets to version control.

# Core Engine Runtime
ENGINE_ENV=development
ENGINE_LOG_LEVEL=INFO
ENGINE_VERSION=0.1.0

